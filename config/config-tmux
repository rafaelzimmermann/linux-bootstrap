#!/bin/bash
set -euo pipefail

assets_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/assets" && pwd)"

# Preserve existing plugins when the bootstrap is run again.
if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
  git clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
fi

install -d "$HOME/.tmux"
install -m 755 "$assets_dir/tmux/window-name.sh" "$HOME/.tmux/window-name.sh"
install -m 644 "$assets_dir/.tmux.conf" "$HOME/.tmux.conf"

if tmux list-sessions >/dev/null 2>&1; then
  tmux source-file "$HOME/.tmux.conf"
fi
